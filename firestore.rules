rules_version = '2';

// Firestore security rules for Student ID Scanner Cloud.
//
// Every document lives under users/{userId}/... and a signed-in user may
// only read or write inside their OWN userId folder. Nobody else —
// including other signed-in users — can read or write it. Unauthenticated
// access is denied everywhere.
//
// Paste these rules into Firebase console > Firestore Database > Rules,
// then Publish.

service cloud.firestore {
  match /databases/{database}/documents {
    // A user may read/write only their own folder, including every
    // subcollection (students, attendance, history, settings).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
